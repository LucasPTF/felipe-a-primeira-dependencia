{
  "redirects": [
    { "source": "/", "destination": "/a1", "permanent": false }
  ],
  "rewrites": [
    { "source": "/a1", "destination": "/index.html" },
    { "source": "/a2", "destination": "/index.html" },
    { "source": "/a3", "destination": "/index.html" },
    { "source": "/obrigado", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
